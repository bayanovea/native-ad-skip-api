        {
          "datasource": {
            "type": "postgres",
            "uid": "ce68e9be-35fa-4d6a-8f59-35f03dae1d52"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    markups.id,\n    'https://example.invalid/video?z=video' || videos.native_id AS \"Видео\",\n    markups.user_id \"Пользователь\",\n    markups.\"createdAt\" \"Время добавления\",\n    STRING_AGG(\n        TO_CHAR(CAST(markup_time_intervals.start AS INTEGER) / 60, 'FM99999') || ':' || \n        TO_CHAR(CAST(markup_time_intervals.start AS INTEGER) % 60, 'FM00') || ' - ' ||\n        TO_CHAR(CAST(markup_time_intervals.end AS INTEGER) / 60, 'FM99999') || ':' || \n        TO_CHAR(CAST(markup_time_intervals.end AS INTEGER) % 60, 'FM00'),\n        ', '\n    ) \"Интервал\",\n    markup_categories.category \"Категория\",\n    markups.deleted_at \"Удалено\",\n    '❌ Удалить' \"Действия\" \nFROM \n    markups\nLEFT JOIN \n    videos ON videos.id = markups.video_id\nLEFT JOIN \n    markup_categories ON markup_categories.id = markups.category_id\nLEFT JOIN \n    markup_time_intervals ON markup_time_intervals.markup_id = markups.id\nGROUP BY \n    markups.id, videos.native_id, markup_categories.category\nORDER BY \n    markups.\"createdAt\" DESC\nLIMIT 10000;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          },
          "table": "markups"
        }
      ],
