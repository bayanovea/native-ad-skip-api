          "rawQuery": true,
          "rawSql": "SELECT\n  'https://example.invalid/video?z=video' || MAX(videos.native_id) AS \"Видео\",\n  SUM(votes.vote) AS summ,\n  votes.video_id,\n  votes.category_id,\n  votes.start,\n  votes.\"end\"\nFROM\n  votes\nLEFT JOIN\n  videos ON videos.id = votes.video_id\nGROUP BY\n  votes.video_id,\n  votes.category_id,\n  votes.start,\n  votes.\"end\"\nORDER BY\n  summ\n",
